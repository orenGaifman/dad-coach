# ============================================================
# Dad Coach Backend - Environment Variables
# ============================================================
# Copy this file to .env and fill in the required values.
# Variables marked [REQUIRED] must be set for the app to start.
# Variables marked [OPTIONAL] have sensible defaults.
# ============================================================

# --- Database Configuration ---

# [REQUIRED] PostgreSQL connection URL
DB_URL=jdbc:postgresql://localhost:5432/dadcoach

# [REQUIRED] PostgreSQL username
DB_USERNAME=dadcoach

# [REQUIRED] PostgreSQL password
DB_PASSWORD=dadcoach

# --- WhatsApp Integration ---

# [REQUIRED] WhatsApp Business API phone number ID
WHATSAPP_PHONE_NUMBER_ID=

# [REQUIRED] WhatsApp Business API access token
WHATSAPP_ACCESS_TOKEN=

# [REQUIRED for dev/prod] Webhook verification token. No default in non-local profiles.
WHATSAPP_VERIFY_TOKEN=your-secure-verify-token-here

# [REQUIRED] WhatsApp webhook secret for HMAC-SHA256 signature verification
WHATSAPP_WEBHOOK_SECRET=your-webhook-app-secret-here

# [OPTIONAL] WhatsApp Graph API version (default: v25.0)
WHATSAPP_API_VERSION=v25.0

# --- Application Configuration ---

# [OPTIONAL] Active Spring profile: local, dev, or prod (default: local)
SPRING_PROFILES_ACTIVE=local

# [OPTIONAL] Server port (default: 8080)
SERVER_PORT=8080
