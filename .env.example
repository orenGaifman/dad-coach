# Dad Coach backend - environment variables (names as in application.yml; DEPLOYMENT.md has the full table).
# Copy to .env for docker compose / local runs. Never commit real values.

# --- Server / database ---
SPRING_PROFILES_ACTIVE=local
# PORT=8081
DB_URL=jdbc:postgresql://localhost:5432/dadcoach
DB_USERNAME=dadcoach
DB_PASSWORD=dadcoach

# --- The dashboard (dashboard_url = WEB_BASE_URL/login, belt images under WEB_BASE_URL/belts) ---
WEB_BASE_URL=http://localhost:3000
# BELT_IMAGES_BASE_URL=

# --- AI Workflow Platform (off locally unless you run it) ---
WORKFLOW_PLATFORM_ENABLED=false
WORKFLOW_PLATFORM_BASE_URL=http://localhost:8080
WORKFLOW_PLATFORM_API_KEY=
WORKFLOW_PLATFORM_WORKER_KEY=dad_3
WORKFLOW_PLATFORM_WORKFLOW_KEY=dad-coach-3
# Key the platform sends to /api/tools and /api/context (platform side: DAD_COACH_API_KEY)
TOOL_API_KEY=
# Scheduled-response callback receiver (platform route WORKFLOW_SCHEDULEDRESPONSECALLBACK_ROUTES_n_*)
WORKFLOW_PLATFORM_CALLBACK_ENABLED=false
WORKFLOW_PLATFORM_CALLBACK_API_KEY=
WORKFLOW_PLATFORM_CALLBACK_TEMPLATE_NAME=

# --- WhatsApp (Dad Coach's own number, Meta Cloud API) ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=dad-coach-local-dev
WHATSAPP_WEBHOOK_SECRET=
# WHATSAPP_API_VERSION=v25.0
# WHATSAPP_API_BASE_URL=https://graph.facebook.com

# --- Security ---
# HMAC secret for the Google Calendar connect links (historical name), >= 32 chars in production
JWT_SECRET=
# Operator API /api/v1/admin/** (X-API-Key); unset = closed
DADCOACH_ADMIN_API_KEY=

# --- Google Calendar (optional for fathers) ---
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8081/api/v1/calendar/callback
